{
  "name": "capcode",
  "version": "0.0.3",
  "description": "Random code -> PNG/SVG/JPEG image + secret-bound signed token with TTL. Zero dependencies, pure TypeScript, configurable font, per-image randomized geometry to defeat OCR.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/captcha.test.mjs",
    "prepublishOnly": "npm run test",
    "example": "node generate.mjs",
    "benchmark": "npm run build && node benchmark.mjs"
  },
  "keywords": [
    "captcha",
    "code",
    "image",
    "png",
    "svg",
    "hmac",
    "token",
    "ttl",
    "verification",
    "security",
    "otp",
    "anti-ocr"
  ],
  "author": "cihatksm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cihatksm/capcode.git"
  },
  "homepage": "https://github.com/cihatksm/capcode#readme",
  "bugs": {
    "url": "https://github.com/cihatksm/capcode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  }
}