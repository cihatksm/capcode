{
  "name": "capcode",
  "version": "0.0.4",
  "description": "Zero-dependency Node.js CAPTCHA generator - PNG/SVG/JPEG image with HMAC-SHA256 signed token & TTL. Stateless pure TypeScript alternative to svg-captcha and captcha-canvas.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/captcha.test.mjs",
    "prepublishOnly": "npm run test",
    "example": "node generate.mjs",
    "benchmark": "npm run build && node benchmark.mjs"
  },
  "keywords": [
    "captcha",
    "captcha generator",
    "nodejs captcha",
    "node captcha",
    "javascript captcha",
    "express captcha",
    "captcha npm",
    "svg-captcha alternative",
    "captcha-canvas alternative",
    "png",
    "svg",
    "jpeg",
    "hmac",
    "ttl",
    "verification",
    "security",
    "otp",
    "anti-ocr"
  ],
  "author": "Cihat Kösem (https://cihatksm.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cihatksm/capcode.git"
  },
  "homepage": "https://github.com/cihatksm/capcode#readme",
  "bugs": {
    "url": "https://github.com/cihatksm/capcode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  }
}